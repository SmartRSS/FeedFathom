# Copy to .env beside compose.yml and edit. Every value has a working
# default, so set only what you need to change.

# Image tag to run. "latest" tracks the newest verified build; pin a full
# 40-character commit SHA to control when you upgrade.
#FEEDFATHOM_TAG=latest

# Published port. Accepts a full binding, so 127.0.0.1:3456 restricts the
# server to loopback for use behind a reverse proxy. Serve the instance over
# HTTPS; see the reverse proxy section of docs/running.md.
#FEEDFATHOM_PORT=3456

# Public host, without scheme or path. Newsletter addresses and the links in
# outbound email are built from it.
#FEED_FATHOM_DOMAIN=localhost:3456

# Pins the Compose project name, and with it the volume name prefix, so the
# volumes do not depend on the directory this was cloned into.
#COMPOSE_PROJECT_NAME=feedfathom

# Account creation. The first account is always allowed. Leave this false
# afterwards unless the instance is meant to accept public signups.
#ENABLE_REGISTRATION=false
# Restrict signups to an exact comma-separated list of addresses.
#ALLOWED_EMAILS=you@example.com

# Simultaneous feed parses. Lower it on a small host; 1 is safe.
#WORKER_CONCURRENCY=25

# PostgreSQL credentials. These initialise a new volume only; changing them
# later does not change an existing database. The DATABASE_URL default does
# not follow them, so set it to match if you change any of them.
#POSTGRES_DB=postgres
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Newsletter ingestion through Cloudflare Email Routing. MAIL_RELAY_SECRET is
# required when MAIL_ENABLED is true, and must match the value set on the
# Cloudflare Worker.
#MAIL_ENABLED=false
#MAIL_RELAY_SECRET=

# Outbound activation email for public registration. Both are required
# together.
#MAILJET_API_KEY=
#MAILJET_API_SECRET=

# Cloudflare Turnstile on the registration form. Both are required together.
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=
