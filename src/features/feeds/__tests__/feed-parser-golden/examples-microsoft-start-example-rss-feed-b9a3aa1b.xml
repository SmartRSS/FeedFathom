                </figcaption>
              </figure>
              <figure>
                <img src="https://h3037e2.example.org/image2.jpg" title="rijob 2 wegej" />
                <figcaption>rijob 2 lotedet
                  <span class="copyright">Lob Nanojij/Jejenera Nutiti</span>
                </figcaption>
              </figure>
            </div>
            ]]>
      </content:encoded>

