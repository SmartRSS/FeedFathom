{
  "action": {
    "default_title": "FeedFathom"
  },
  "background": {
    "scripts": ["background-event.js"],
    "service_worker": "background-event.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      },
      "id": "feedfathom@smartrss",
      "strict_min_version": "140.0"
    }
  },
  "content_scripts": [
    {
      "js": ["content-script.js"],
      "matches": ["*://*/*"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src http: https:"
  },
  "description": "Companion for your FeedFathom instance.",
  "host_permissions": ["*://*/*"],
  "icons": {
    "48": "48-inverted-round.png",
    "64": "64-inverted-round.png",
    "96": "96-inverted-round.png",
    "128": "128-inverted-round.png"
  },
  "manifest_version": 3,
  "name": "FeedFathom",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": ["contextMenus", "storage"],
  "version": "0.1"
}
