{
  "name": "FeedFathom",
  "short_name": "FeedFathom",
  "description": "Self-hosted RSS reader",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0060df",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "/icons/48-inverted-round.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "/icons/64-inverted-round.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/icons/96-inverted-round.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/128-inverted-round.png",
      "sizes": "128x128",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/preview",
    "method": "GET",
    "params": { "url": "feedUrl" }
  }
}
