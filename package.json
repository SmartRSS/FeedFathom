{
  "name": "feedfathom-app",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#platform/*": "./src/platform/*",
    "#features/*": "./src/features/*"
  },
  "scripts": {
    "dev": "bun ./bin/dev.ts",
    "dev:down": "bun ./bin/dev.ts --down",
    "build-extension": "bun ./bin/generate-packages.ts && bunx web-ext build --source-dir ext/build-ch --artifacts-dir ext --filename feedfathom_ch.zip --overwrite-dest && bunx web-ext build --source-dir ext/build-ff --artifacts-dir ext --filename feedfathom_ff.zip --overwrite-dest",
    "build-cloudflare-email-worker": "bun build ./src/features/mail-ingest/email-worker.ts --outfile ./build/cloudflare-email-worker.js --target=browser",
    "build-server": "bun run build-spa && bun build src/server.ts --outfile build/index.js --target bun",
    "build-migrator": "bun build ./src/migrator.ts --outdir=./build/ --target=bun --sourcemap",
    "build-worker": "bun build ./src/worker.ts --outdir=./build/ --target=bun --sourcemap",
    "build-project": "rm -rf build && mkdir -p build && bun run build-server && bun run build-migrator && bun run build-worker && bun run build-extension && bun run build-cloudflare-email-worker",
    "watch-worker": "bun --watch ./src/worker.ts",
    "build-spa": "bun ./bin/build-spa.ts",
    "watch-spa": "vite --config src/spa/vite.config.ts",
    "watch-spa-api": "PORT=3001 bun --watch src/server.ts",
    "test:unit": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/feedfathom_test} bun test --parallel=2 --path-ignore-patterns='tests/browser/**' --path-ignore-patterns='**/*-integration.test.ts'",
    "test:migrations": "bun test src/features/feeds/__tests__/opml-import-integration.test.ts src/__tests__/migration-integration.test.ts src/features/auth/__tests__/sessions-integration.test.ts src/features/feeds/__tests__/retention-integration.test.ts src/features/feeds/__tests__/article-visibility-integration.test.ts src/features/feeds/__tests__/article-search-integration.test.ts src/features/feeds/__tests__/folder-order-integration.test.ts src/features/feeds/__tests__/source-scheduling-integration.test.ts src/features/feeds/__tests__/unread-agreement-integration.test.ts",
    "test:browser": "bun run build-extension && playwright test --config tests/browser/playwright.config.ts",
    "test:smoke": "bun -e 'if (!process.env.PLAYWRIGHT_BASE_URL) throw new Error(\"PLAYWRIGHT_BASE_URL is required\")' && playwright test --config tests/browser/playwright.config.ts tests/browser/production-smoke.spec.ts",
    "quality": "bun run test:unit && bun run test:browser && bun run lint && bun run build-project",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "bun run format && bun run oxlint && bun run knip",
    "lint:fix": "bun run format:fix && bun run oxlint:fix",
    "oxlint": "oxlint",
    "oxlint:fix": "oxlint --fix",
    "knip": "knip",
    "generate-migrations": "drizzle-kit generate --config drizzle/config.json && bun run format:fix"
  },
  "dependencies": {
    "@extractus/article-extractor": "^9.0.1",
    "@mozilla/readability": "^0.6.0",
    "@rowanmanning/feed-parser": "^2.1.4",
    "bullmq": "^6.3.4",
    "disposable-email-domains-js": "^1.25.0",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "elysia": "2.0.0-beta.14",
    "fast-xml-parser": "file:./vendor/fast-xml-parser-shim",
    "ioredis": "^6.0.0",
    "linkedom": "file:./vendor/linkedom-shim",
    "mailparser": "^3.9.22",
    "microformats-parser": "^2.0.6",
    "sanitize-html": "^2.17.7",
    "solid-js": "^1.9.15",
    "typebox": "1.3.28"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.1",
    "@types/sanitize-html": "^2.16.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "web-ext": "10.6.0"
  },
  "peerDependencies": {},
  "overrides": {
    "fast-xml-parser": "file:./vendor/fast-xml-parser-shim",
    "linkedom": "file:./vendor/linkedom-shim"
  },
  "packageManager": "bun@1.4.2",
  "knip": {
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
      "src/server.ts",
      "src/worker.ts",
      "src/migrator.ts",
      "src/features/mail-ingest/email-worker.ts",
      "src/extension/{background-event,content-script,options,popup}.ts",
      "tests/browser/**/*.ts",
      "bin/**/*.ts",
      "tools/**/*.js",
      "vendor/**/__tests__/*.ts",
      "src/**/*.test.ts",
      "src/features/feeds/__tests__/opml-parser-cases/**/*.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "tests/browser/**/*.ts",
      "bin/**/*.ts",
      "tools/**/*.js",
      "vendor/**/__tests__/*.ts"
    ],
    "ignoreUnresolved": [],
    "ignoreDependencies": [
      "linkedom"
    ]
  }
}
