{
  "name": "feedfathom-app",
  "version": "0.0.1",
  "private": false,
  "scripts": {
    "dev": "export _UID=$(id -u) && export _GID=$(id -g) && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "build-extension": "bun ./bin/generate-packages.ts",
    "build-server": "export BUILD=true && bun run svelte-kit sync && bunx --bun vite build",
    "build-worker": "bun build ./src/worker-entrypoint.ts --outdir=./build/ --target=bun --sourcemap",
    "build-for-image": "bun build-server && bun build-worker",
    "build-project": "rm -rf build && mkdir -p build && (bun build-server & bun build-worker & bun build-extension & wait)",
    "watch-server": "svelte-kit sync && vite dev --host",
    "watch-worker": "svelte-kit sync && bun --watch ./src/worker-entrypoint.ts",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && bun test && biome check && tsc && bun svelte-check && bun knip",
    "lint:fix": "svelte-kit sync && bun biome:fix",
    "biome:fix": "biome check --write",
    "knip": "knip",
    "generate-migrations": "drizzle-kit generate && bun biome:fix"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.56.8",
    "vite": "^7.3.6",
    "@biomejs/biome": "^2.5.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.2.5",
    "@types/jsdom": "^21.1.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/smtp-server": "^3.5.13",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "archiver": "^7.0.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "knip": "^5.88.1",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
    "@mozilla/readability": "^0.6.0",
    "@rowanmanning/feed-parser": "^2.1.4",
    "arktype": "^2.2.3",
    "awilix": "^12.1.1",
    "axios": "^1.19.0",
    "axios-cache-interceptor": "^1.12.3",
    "disposable-email-domains-js": "^1.25.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^26.1.0",
    "mailparser": "^3.9.15",
    "node-mailjet": "^6.0.11",
    "smtp-server": "^3.19.3",
    "ulid": "^3.0.2"
  },
  "type": "module",
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "knip": {
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
      "src/**/*.{ts,svelte}",
      "tests/**/*.ts",
      "bin/**"
    ],
    "ignore": [
      "build/**",
      "ext/**",
      "rollout.ts",
      "src/cloudflare/**"
    ],
    "ignoreBinaries": [
      "build"
    ],
    "ignoreUnresolved": [
      "^\\$service-worker"
    ]
  }
}
